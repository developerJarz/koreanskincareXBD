# MongoDB
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/noorsbd

# Auth
# Required: signs login sessions. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=
BETTER_AUTH_SECRET=generate-a-random-32-char-secret
BETTER_AUTH_URL=http://localhost:5173

# OAuth (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=

# Cloudinary — image hosting/CDN for product, brand and category images (required in production).
# Admin/vendor uploads (files or "Add from link") go straight to Cloudinary. To move images saved
# in local folders to Cloudinary: npm run images:migrate
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Payment gateways (sandbox)
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=
SSLCOMMERZ_IS_SANDBOX=true
BKASH_APP_KEY=
BKASH_APP_SECRET=
BKASH_USERNAME=
BKASH_PASSWORD=
NAGAD_MERCHANT_ID=
NAGAD_MERCHANT_NUMBER=

# Courier APIs (optional)
STEADFAST_API_KEY=
STEADFAST_SECRET_KEY=
PATHAO_CLIENT_ID=
PATHAO_CLIENT_SECRET=
REDX_API_TOKEN=

# Seeding — /api/seed is disabled unless this is "true" (keep false in production)
ALLOW_DB_SEED=false
# Used only by scripts/update-passwords.mjs and the seeder; leave empty to auto-generate
SEED_SUPER_ADMIN_PASSWORD=
SEED_ADMIN_PASSWORD=
SEED_STAFF_PASSWORD=
SEED_CUSTOMER_PASSWORD=

# Email (SMTP, e.g. Brevo) — used for sign-up and password-reset codes
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Must be a sender address verified with your email provider
SMTP_FROM="koreanskincare.bd <no-reply@koreanskincare.bd>"
